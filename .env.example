APP_NAME="Esthetic Renovations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://edsthetic.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=edsthetic
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="quotes@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gallery originals and WebP conversions (php artisan storage:link).
MEDIA_DISK=public

# Spatie settings are cached. Saving settings clears this cache.
SETTINGS_CACHE_ENABLED=true

# Quote form: requests per IP, then the window in seconds.
QUOTE_RATE_LIMIT=5
QUOTE_RATE_DECAY_SECONDS=3600

# Honeypot rejects filled hidden fields and submissions faster than this many seconds.
HONEYPOT_ENABLED=true
HONEYPOT_SECONDS=1

# Enquiry emails and WhatsApp alerts are queued. Run a worker or they sit in the jobs table:
# php artisan queue:work
#
# WhatsApp alerts are sent from his WhatsApp Business account (Meta Cloud API)
# to the WhatsApp number in Site settings. Leave the token blank to skip WhatsApp.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v22.0
#
# POPIA pruning runs daily at 02:10. Run the scheduler:
# php artisan schedule:work
# Or manually: php artisan enquiries:prune
#
# Create the first admin (prompts for a password; nothing is seeded):
# php artisan admin:create
