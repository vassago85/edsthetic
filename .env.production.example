APP_NAME="Esthetic Renovations"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://edsthetic.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=edsthetic-pgsql
DB_PORT=5432
DB_DATABASE=edsthetic
DB_USERNAME=edsthetic
DB_PASSWORD=change-me-strong

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.edsthetic.co.za

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=edsthetic-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=info@edsthetic.co.za
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MEDIA_DISK=public
SETTINGS_CACHE_ENABLED=true

QUOTE_RATE_LIMIT=5
QUOTE_RATE_DECAY_SECONDS=3600

HONEYPOT_ENABLED=true
HONEYPOT_SECONDS=1

# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v22.0

APP_RUN_MIGRATIONS_ON_BOOT=true
TRUSTED_PROXIES=*

# Make bare `docker compose` use the prod file on the server:
COMPOSE_FILE=docker-compose.prod.yml
